{
  "name": "alchemy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run assets:verify && tsc -b && vite build",
    "assets:verify": "node scripts/verify-public-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "balance:gate": "vitest run src/engine/__tests__/balanceDeckMatrix.apprentice.test.ts src/engine/__tests__/balanceDeckMatrix.alchemist.test.ts src/engine/__tests__/balanceDeckMatrix.archmage.test.ts --maxWorkers=3",
    "test:watch": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "howler": "^2.2.4",
    "peerjs": "^1.5.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "uuid": "^13.0.2",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "7.0.5"
    }
  }
}
